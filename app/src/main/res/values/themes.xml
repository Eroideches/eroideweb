<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EroideWeb" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!--
        Temi delle sole WebView. Dicono alla pagina se l'app è chiara o scura
        (isLightTheme → prefers-color-scheme) e abilitano lo scurimento
        automatico dei siti: il tema dell'activity resta indipendente.
    -->
    <style name="Theme.EroideWeb.Web.Light" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Theme.EroideWeb.Web.Dark" parent="android:Theme.Material.NoActionBar" />
</resources>
