<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Un browser senza rete non serve. Nessun altro permesso in Fase 0:
         niente analytics, niente crash reporting, niente SDK di terze parti. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".EroideWebApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EroideWeb"
        android:usesCleartextTraffic="true">

        <!-- usesCleartextTraffic=true è voluto: un browser deve poter aprire
             anche siti http:// (nessun upgrade forzato lato app). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Finestra privata in un processo separato: cookie, cache e storage
             WebView vivono in una directory dedicata, svuotata all'uscita. -->
        <activity
            android:name=".PrivateActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":private"
            android:windowSoftInputMode="adjustResize" />

        <!-- I file scaricati stanno nello storage privato dell'app e vengono
             condivisi in sola lettura con l'app scelta dall'utente. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
